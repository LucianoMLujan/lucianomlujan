---
import { Icon } from "astro-icon/components";

const skills = [
	{ name: "HTML5", color: "#e34f26", icon: "simple-icons:html5" },
	{ name: "CSS3", color: "#264de4", icon: "simple-icons:css3" },
	{ name: "JavaScript", color: "#f7df1e", icon: "simple-icons:javascript" },
	{ name: "TypeScript", color: "#3178c6", icon: "simple-icons:typescript" },
	{ name: "PHP", color: "#777bb4", icon: "simple-icons:php" },
	{ name: "Laravel", color: "#ff2d20", icon: "simple-icons:laravel" },
	{ name: "Vue.js", color: "#42b883", icon: "simple-icons:vuedotjs" },
	{ name: "Angular", color: "#dd0031", icon: "simple-icons:angular" },
	{ name: "Tailwind", color: "#38bdf8", icon: "simple-icons:tailwindcss" },
	{ name: "Node.js", color: "#339933", icon: "simple-icons:nodedotjs" },
	{ name: "jQuery", color: "#0769ad", icon: "simple-icons:jquery" },
	{ name: "MySQL", color: "#4479a1", icon: "simple-icons:mysql" },
	{ name: "MongoDB", color: "#47a248", icon: "simple-icons:mongodb" },
	{ name: "C#", color: "#68217a", icon: "simple-icons:csharp" },
	{ name: ".NET", color: "#512bd4", icon: "simple-icons:dotnet" },
	{ name: "MS SQL", color: "#cc2927", icon: "simple-icons:microsoftsqlserver" },
	{ name: "Docker", color: "#2496ed", icon: "simple-icons:docker" },
	{ name: "AWS", color: "#ff9900", icon: "simple-icons:amazonaws" },
];
---

<section id="habilidades" class="relative py-20 md:py-28 overflow-hidden">
	<!-- Subtle gradient bg -->
	<div class="absolute inset-0 bg-gradient-to-b from-base via-surface/30 to-base"></div>
	<div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-accent/5 via-transparent to-transparent"></div>

	<div class="relative mx-auto max-w-5xl px-5">
		<!-- Title -->
		<h2 class="font-display text-3xl md:text-4xl font-bold tracking-tight text-center mb-4">
			<span class="gradient-text">Habilidades técnicas</span>
		</h2>
		<p class="text-muted text-center mb-14 text-sm md:text-base">
			Tecnologías que domino para crear soluciones innovadoras
		</p>

		<!-- Icons grid -->
		<div class="grid grid-cols-4 sm:grid-cols-5 md:grid-cols-6 lg:grid-cols-7 gap-x-4 gap-y-8 justify-items-center">
			{skills.map((skill, i) => (
				<div
					class="skill-item group relative flex flex-col items-center gap-2 cursor-default"
					style={`--skill-color: ${skill.color}; animation-delay: ${i * 50}ms`}
				>
					<!-- Glow ring behind icon -->
					<div
						class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-16 h-16 rounded-full opacity-0 group-hover:opacity-100 blur-xl transition-opacity duration-200"
						style={`background: ${skill.color}`}
					></div>

					<!-- Icon circle -->
					<div
						class="relative z-10 w-14 h-14 md:w-16 md:h-16 rounded-2xl flex items-center justify-center border border-line/40 bg-surface/60 transition-all duration-200 ease-out group-hover:scale-110 group-hover:border-transparent will-change-transform"
					>
						<!-- Colored bg on hover -->
						<div
							class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-200"
							style={`background: ${skill.color}`}
						></div>
						<!-- Icon -->
						<Icon
							name={skill.icon}
							class="relative z-10 h-7 w-7 md:h-8 md:w-8 transition-transform duration-200 ease-out group-hover:scale-105 will-change-transform"
							style={`color: ${["JavaScript", "AWS"].includes(skill.name) ? "#000" : "#fff"}`}
						/>
					</div>

					<!-- Label -->
					<span class="relative z-10 text-xs md:text-sm font-medium text-white/80 group-hover:text-white transition-colors duration-200">
						{skill.name}
					</span>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.skill-item {
		opacity: 0;
		animation: skill-fade-in 0.4s ease-out forwards;
	}

	@keyframes skill-fade-in {
		from {
			opacity: 0;
			transform: translateY(12px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.gradient-text {
		background: linear-gradient(135deg, #a78bfa 0%, #60a5fa 50%, #34d399 100%);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}
</style>
