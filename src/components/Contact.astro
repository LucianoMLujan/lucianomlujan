---

<section id="contacto" class="border-t border-line bg-surface/40">
	<div class="mx-auto max-w-5xl px-5 py-20 md:py-28">
		<div class="overflow-hidden rounded-3xl border border-line bg-gradient-to-br from-accent/10 via-surface to-sky-500/10">
			<div class="mx-auto max-w-3xl px-6 py-14 text-center md:py-20">
				<p
					class="mb-3 inline-block rounded-full border border-line bg-surface px-3.5 py-1 text-xs font-medium tracking-wide text-accent-soft uppercase"
				>
					Contacto
				</p>
				<h2 class="font-display text-3xl font-bold tracking-tight md:text-5xl">
					Trabajemos <span class="gradient-text">juntos</span>
				</h2>
				<p class="mx-auto mt-4 max-w-xl text-muted">
					¿Tenés un proyecto o una oportunidad laboral? Escribime y te
					respondo lo antes posible.
				</p>

				<a
					href="mailto:lucianomlujan@gmail.com"
					class="group mt-8 inline-flex items-center gap-2 rounded-xl bg-accent px-7 py-3.5 text-sm font-semibold text-white shadow-lg shadow-accent/30 transition-all hover:-translate-y-0.5 hover:shadow-xl hover:shadow-accent/40"
				>
					<svg class="h-4 w-4 transition-transform group-hover:-translate-y-0.5 group-hover:scale-110" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<rect width="20" height="16" x="2" y="4" rx="2" />
						<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
					</svg>
					Escríbeme un email
				</a>

				<div class="mt-12 grid gap-4 text-left sm:grid-cols-2">
					{items.map((item) => (
						<a
							href={item.href || "#"}
							target={item.href?.startsWith("http") ? "_blank" : undefined}
							rel="noopener"
							class:list={[
								"card-shine group relative flex items-center gap-4 rounded-2xl border border-line/60 bg-surface/50 px-5 py-4 transition-all duration-300",
								item.href ? "cursor-pointer hover:border-accent/30 hover:bg-surface" : "cursor-default",
							]}
						>
							<div class="icon-ring flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-accent/20 to-accent/5 text-accent-soft ring-1 ring-accent/10 transition-all duration-300 group-hover:from-accent/30 group-hover:to-accent/10 group-hover:ring-accent/20 group-hover:scale-110">
								<Fragment set:html={item.icon} />
							</div>
							<div class="min-w-0 flex-1">
								<p class="text-[11px] font-medium tracking-widest text-muted/70 uppercase">
									{item.label}
								</p>
								<p class="mt-0.5 truncate text-sm font-medium text-white/90 transition-colors group-hover:text-white">
									{item.value}
								</p>
							</div>
							{item.href && (
								<svg class="h-4 w-4 shrink-0 text-muted/40 transition-all duration-300 group-hover:translate-x-0.5 group-hover:text-accent-soft" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M7 17L17 7" />
									<path d="M7 7h10v10" />
								</svg>
							)}
						</a>
					))}
				</div>

				<style>
					.card-shine {
						background-image: radial-gradient(
							600px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
							rgba(139, 92, 246, 0.06),
							transparent 40%
						);
					}
					.card-shine:hover {
						background-image: radial-gradient(
							600px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
							rgba(139, 92, 246, 0.1),
							transparent 40%
						);
					}
				</style>

				<script>
					function initCardShine() {
						document.querySelectorAll('.card-shine').forEach((card) => {
							card.addEventListener('mousemove', (e) => {
								const rect = (e.currentTarget as HTMLElement).getBoundingClientRect();
								const x = e.clientX - rect.left;
								const y = e.clientY - rect.top;
								(e.currentTarget as HTMLElement).style.setProperty('--mouse-x', `${x}px`);
								(e.currentTarget as HTMLElement).style.setProperty('--mouse-y', `${y}px`);
							});
						});
					}

					initCardShine();
					document.addEventListener('astro:page-load', initCardShine);
				</script>
			</div>
		</div>
	</div>
</section>