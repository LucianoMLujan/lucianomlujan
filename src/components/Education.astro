---
const education = [
	{
		title: "Licenciatura en Sistemas de la Información",
		institution: "Universidad Autónoma de Entre Ríos",
		period: "2019 — 2022",
		completed: false,
	},
	{
		title: "Ingeniería en Sistemas de la Información",
		institution: "UTN CDU",
		period: "2016 — 2019",
		completed: false,
	},
	{
		title: "Analista en Sistemas",
		institution: "Sedes Sapientiae",
		period: "2013 — 2016",
		completed: false,
	},
];

const certifications = [
	{
		title: "Idioma — Inglés",
		provider: "Trinity 4",
		detail: "Nivel Intermedio",
		icon: "🇺🇸",
	},
	{
		title: "Master en Desarrollo Web Full Stack",
		provider: "Udemy",
		detail: "Mar 2021 · 35 horas",
	},
	{
		title: "Master en PHP, SQL y Laravel",
		provider: "Udemy",
		detail: "Jul 2020 · 56.5 horas",
	},
];
---

<section id="educacion" class="relative py-20 md:py-28 overflow-hidden">
	<!-- Background -->
	<div class="absolute inset-0 bg-gradient-to-b from-base via-surface/20 to-base"></div>
	<div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_left,_var(--tw-gradient-stops))] from-accent/5 via-transparent to-transparent"></div>

	<div class="relative mx-auto max-w-5xl px-5">
		<!-- Header -->
		<p
			class="mb-3 inline-block rounded-full border border-accent/30 bg-accent/10 px-3.5 py-1 text-xs font-medium tracking-wide text-accent-soft uppercase backdrop-blur-sm"
		>
			Formación
		</p>
		<h2 class="mb-14 font-display text-3xl font-bold tracking-tight md:text-4xl">
			<span class="gradient-text">Educación y certificaciones</span>
		</h2>

		<!-- Column headers -->
		<div class="grid gap-8 md:grid-cols-2 mb-4">
			<h3 class="font-display text-sm font-semibold tracking-wide text-accent-soft uppercase">
				Educación
			</h3>
			<h3 class="font-display text-sm font-semibold tracking-wide text-accent-soft uppercase">
				Certificaciones
			</h3>
		</div>

		<!-- Cards grid: 2 columns with equal row heights -->
		<div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-stretch">
			<!-- Education column -->
			<div class="flex flex-col gap-4 h-full">
				{education.map((item, i) => (
					<div
						class="edu-item group relative flex-1 rounded-2xl border border-line/40 bg-surface/40 p-5 overflow-hidden transition-all duration-200 hover:border-accent/30 hover:bg-surface/60"
						style={`animation-delay: ${i * 80}ms`}
					>
						<div class="absolute inset-0 bg-gradient-to-br from-accent/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-200"></div>
						<div class="relative h-full flex flex-col justify-between">
							<div>
								<div class="flex items-start justify-between gap-2">
									<div class="flex-1 min-w-0">
										<h4 class="font-display font-semibold text-white leading-tight">{item.title}</h4>
										<p class="text-sm text-accent-soft mt-1">{item.institution}</p>
									</div>
									<span class="flex-shrink-0 inline-flex items-center rounded-full bg-muted/10 border border-line/40 px-2.5 py-0.5 text-[10px] font-medium text-muted">
										Incompleto
									</span>
								</div>
							</div>
							<p class="text-xs text-muted mt-3">{item.period}</p>
						</div>
					</div>
				))}
			</div>

			<!-- Certifications column -->
			<div class="flex flex-col gap-4 h-full">
				{certifications.map((item, i) => (
					<div
						class="cert-item group relative flex-1 rounded-2xl border border-line/40 bg-surface/40 p-5 overflow-hidden transition-all duration-200 hover:border-accent/30 hover:bg-surface/60"
						style={`animation-delay: ${(i + education.length) * 80}ms`}
					>
						<div class="absolute inset-0 bg-gradient-to-br from-accent/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-200"></div>
						<div class="relative h-full flex flex-col justify-between">
							<div>
								{item.icon ? (
									<div class="inline-flex items-center gap-1.5 rounded-full bg-accent/10 border border-accent/20 px-2.5 py-0.5 text-[10px] font-medium text-accent-soft mb-3">
										<span class="text-sm">{item.icon}</span>
										{item.provider}
									</div>
								) : (
									<div class="inline-flex items-center rounded-full bg-accent/10 border border-accent/20 px-2.5 py-0.5 text-[10px] font-medium text-accent-soft mb-3">
										{item.provider}
									</div>
								)}
								<h4 class="font-display font-semibold text-white leading-tight">{item.title}</h4>
							</div>
							<p class="text-xs text-muted mt-3">{item.detail}</p>
						</div>
					</div>
				))}
			</div>
		</div>
	</div>
</section>

<style>
	.edu-item,
	.cert-item {
		opacity: 0;
		animation: fade-slide-in 0.4s ease-out forwards;
	}

	@keyframes fade-slide-in {
		from {
			opacity: 0;
			transform: translateY(10px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.gradient-text {
		background: linear-gradient(135deg, #a78bfa 0%, #60a5fa 50%, #34d399 100%);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}
</style>
